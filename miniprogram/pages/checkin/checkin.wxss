.page {
    min-height: 100vh;
    background: #f5f7fa;
    padding: 40rpx 32rpx;
}

.header {
    text-align: center;
    margin-bottom: 40rpx;
}

.title {
    display: block;
    font-size: 36rpx;
    font-weight: 700;
    color: #1f2329;
}

.subtitle {
    display: block;
    margin-top: 8rpx;
    font-size: 26rpx;
    color: #8a919f;
}

.status-card {
    background: #ffffff;
    border-radius: 16rpx;
    padding: 60rpx 32rpx;
    text-align: center;
    margin-bottom: 24rpx;
}

.status-icon {
    font-size: 80rpx;
    margin-bottom: 24rpx;
}

.status-text {
    display: block;
    font-size: 30rpx;
    color: #4b5563;
}

.beacon-info {
    background: #eff6ff;
    border-radius: 12rpx;
    padding: 24rpx;
    margin-bottom: 24rpx;
}

.beacon-info.warn {
    background: #fffbeb;
}

.label {
    display: block;
    font-size: 24rpx;
    color: #6b7280;
    margin-bottom: 8rpx;
}

.uuid {
    display: block;
    font-size: 26rpx;
    color: #1d4ed8;
    word-break: break-all;
}

.checkin-btn {
    width: 100%;
    font-size: 34rpx;
    padding: 16rpx 0;
}

.tip {
    display: block;
    margin-top: 24rpx;
    font-size: 24rpx;
    color: #a0a6b1;
    text-align: center;
}
