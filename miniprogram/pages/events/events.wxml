<view class="page">
    <view wx:if="{{loading}}" class="state">
        <text>加载中…</text>
    </view>

    <view wx:elif="{{error}}" class="state">
        <text>{{error}}</text>
        <button class="btn-primary retry-btn" bindtap="loadEvents">重新加载</button>
    </view>

    <view wx:elif="{{list.length === 0}}" class="state">
        <text>暂无已报名的活动</text>
    </view>

    <view wx:else>
        <view class="event-card" wx:for="{{list}}" wx:key="id">
            <view class="event-info">
                <text class="event-title">{{item.title}}</text>
                <text class="event-location">{{item.location}}</text>
                <text class="event-status">{{item.checked_in === 1 ? '已签到 ✓' : '未签到'}}</text>
            </view>
            <button
                wx:if="{{item.checked_in !== 1}}"
                class="btn-primary checkin-btn"
                size="mini"
                data-item="{{item}}"
                bindtap="goCheckin"
            >去签到</button>
        </view>
    </view>

    <button class="logout-btn" bindtap="logout">退出登录</button>
</view>
