.page {
    min-height: 100vh;
    background: #f5f7fa;
    padding-bottom: 40rpx;
}

.state {
    padding: 120rpx 40rpx;
    text-align: center;
    color: #8a919f;
    font-size: 28rpx;
}

.retry-btn {
    margin-top: 24rpx;
    width: 240rpx;
}

.event-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border-radius: 16rpx;
    padding: 28rpx 24rpx;
    margin: 16rpx 24rpx;
}

.event-info {
    flex: 1;
    margin-right: 16rpx;
}

.event-title {
    display: block;
    font-size: 30rpx;
    font-weight: 600;
    color: #1f2329;
}

.event-location {
    display: block;
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #8a919f;
}

.event-status {
    display: block;
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #10b981;
}

.checkin-btn {
    flex-shrink: 0;
}

.logout-btn {
    margin: 40rpx 24rpx 0;
    background: #ffffff;
    color: #ef4444;
    font-size: 28rpx;
}
