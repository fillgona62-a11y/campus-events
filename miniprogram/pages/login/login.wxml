<view class="page">
    <view class="hero">
        <text class="title">校园活动签到</text>
        <text class="subtitle">蓝牙信标 + 定位，核验真实到场</text>
    </view>

    <view class="form-card">
        <view class="field">
            <text class="label">学号</text>
            <input class="input" placeholder="请输入学号" value="{{studentId}}" bindinput="onInputStudentId" />
        </view>
        <view class="field">
            <text class="label">密码</text>
            <input class="input" password placeholder="请输入密码" value="{{password}}" bindinput="onInputPassword" />
        </view>
        <button class="btn-primary login-btn" bindtap="handleLogin" disabled="{{loading}}">
            {{loading ? '登录中…' : '登录'}}
        </button>
    </view>

    <text class="tip">账号与网页版校园活动系统一致</text>
</view>
