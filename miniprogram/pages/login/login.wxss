.page {
    min-height: 100vh;
    background: #f5f7fa;
}

.hero {
    padding: 80rpx 40rpx 40rpx;
    text-align: center;
}

.title {
    display: block;
    font-size: 44rpx;
    font-weight: 700;
    color: #1f2329;
}

.subtitle {
    display: block;
    margin-top: 12rpx;
    font-size: 26rpx;
    color: #8a919f;
}

.form-card {
    margin: 0 48rpx;
    background: #ffffff;
    border-radius: 16rpx;
    padding: 40rpx 32rpx;
}

.field {
    margin-bottom: 32rpx;
}

.label {
    display: block;
    font-size: 26rpx;
    color: #4b5563;
    margin-bottom: 12rpx;
}

.input {
    border: 1rpx solid #e5e7eb;
    border-radius: 12rpx;
    padding: 20rpx 24rpx;
    font-size: 30rpx;
}

.login-btn {
    width: 100%;
    margin-top: 12rpx;
    font-size: 32rpx;
}

.tip {
    display: block;
    text-align: center;
    margin-top: 32rpx;
    font-size: 24rpx;
    color: #a0a6b1;
}
