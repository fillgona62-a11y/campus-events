# 服务端口
PORT=3000

# JWT 密钥（生产环境务必改为强随机值，生成：bash server/scripts/gen-jwt-secret.sh）
JWT_SECRET=please-change-me-to-a-long-random-string
# JWT 有效期（默认 7 天）
JWT_EXPIRES_IN=7d

# SQLite 数据库文件路径（相对 server 目录或绝对路径）
DB_PATH=./data/data.db

# 封面图上传目录（相对 server 目录或绝对路径）
UPLOAD_DIR=./uploads

# 初始管理员账号（仅首次启动、账号不存在时创建）
ADMIN_STUDENT_ID=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=系统管理员

# ===== 邮件通道（F3 注册验证码 / F2 找回密码）=====
# SMTP 服务器：QQ 邮箱 smtp.qq.com / 163 邮箱 smtp.163.com
SMTP_HOST=smtp.qq.com
# 端口：465(secure=true) 或 587(secure=false)
SMTP_PORT=465
SMTP_SECURE=true
# 发件邮箱地址（与授权码对应）
SMTP_USER=your-name@qq.com
# SMTP 授权码（不是邮箱登录密码！在邮箱设置-账户-POP3/SMTP 服务中开通）
SMTP_AUTH_CODE=your-smtp-auth-code
# 发件人显示（默认同 SMTP_USER）
SMTP_FROM=校园活动报名系统
# 开发/演示模式：=1 时不发真实邮件，验证码在接口响应 dev_code 与服务器日志回显
SMTP_DEV_ECHO=1

# ===== 登录失败锁定（F12）=====
LOGIN_LOCK_MAX_ATTEMPTS=5      # 连续失败次数上限
LOGIN_LOCK_MINUTES=15          # 锁定时长（分钟）

# ===== 邮箱验证码规则（F3/F2）=====
EMAIL_CODE_EXPIRE_MINUTES=5        # 有效期（分钟）
EMAIL_CODE_RESEND_COOLDOWN_SEC=60  # 同邮箱重发冷却（秒）
EMAIL_CODE_MAX_ATTEMPTS=5          # 单码校验错误上限（次）
